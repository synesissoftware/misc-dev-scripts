# .gitattributes — generic (union of language templates)
#
# Sources: union of c, cxx, c#, go, javascript, python, ruby, rust, zig
# templates derived from GitHub Docs, git-scm, gitattributes/gitattributes,
# and github-linguist. Prefer a language-specific template when possible.

# Default: detect text, normalize to LF in the repository
* text=auto

# --- Source ---
