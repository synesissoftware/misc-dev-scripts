# .gitattributes — Python (GitHub-hosted)
#
# Sources: GitHub Docs (line endings), git-scm gitattributes (diff=python),
# gitattributes/gitattributes Python.gitattributes + Common.gitattributes,
# github-linguist overrides.

# Default: detect text, normalize to LF in the repository
* text=auto

# --- Source ---
*.pxd text diff=python
*.py text eol=lf diff=python
*.py3 text eol=lf diff=python
*.pyi text eol=lf diff=python
*.pyx text diff=python
*.pyw text eol=lf diff=python
*.pyz text diff=python
*.ipynb text eol=lf

# --- Config / lock ---
*.cfg text
*.ini text
*.toml text
Pipfile text
Pipfile.lock text -diff
poetry.lock text -diff
pyproject.toml text
requirements*.txt text
setup.cfg text
setup.py text eol=lf diff=python

# --- Scripts ---
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.zsh text eol=lf

# --- Docs / meta ---
*.adoc text
*.markdown text diff=markdown
*.md text diff=markdown
*.txt text
AUTHORS text
CHANGELOG text
CHANGES text
CONTRIBUTING text
COPYING text
LICENSE text
NEWS text
README text
TODO text
.gitattributes text
.gitignore text

# --- Serialisation ---
*.json text
*.xml text
*.yaml text
*.yml text

# --- Binary / bytecode ---
*.db binary
*.p binary
*.pickle binary
*.pkl binary
*.pyc binary export-ignore
*.pyd binary
*.pyo binary export-ignore
*.so binary
*.whl binary

# --- Archives / images (common) ---
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.tar binary
*.zip binary

# --- GitHub Linguist ---
**/__pycache__/** linguist-generated
**/.mypy_cache/** linguist-generated
**/.pytest_cache/** linguist-generated
**/.ruff_cache/** linguist-generated
**/dist/** linguist-generated
**/*.egg-info/** linguist-generated
